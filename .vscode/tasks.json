{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/MD",
                "/nologo",

                "/std:c++17",

                "/I${workspaceFolder}\\include",

                "/Fo${workspaceFolder}\\bin\\",
                "/Fe${workspaceFolder}\\bin\\vertex-mk-alpha.exe",

                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\chess\\board.cpp",
                "${workspaceFolder}\\src\\chess\\position.cpp",
                "${workspaceFolder}\\src\\chess\\move_generation\\attack_tables.cpp",
                "${workspaceFolder}\\src\\chess\\move_generation\\attacks.cpp",
                "${workspaceFolder}\\src\\chess\\move_generation\\movegen.cpp",
                "${workspaceFolder}\\src\\uci\\uci.cpp",
                "${workspaceFolder}\\src\\chess\\engine\\evaluation\\evaluation.cpp",
                "${workspaceFolder}\\src\\chess\\engine\\search.cpp",
                "${workspaceFolder}\\src\\chess\\engine\\move_ordering.cpp",
                "${workspaceFolder}\\src\\chess\\engine\\search_stack.cpp",

                "/link",
                "/LIBPATH:${workspaceFolder}\\lib",
                "opengl32.lib",
                "gdi32.lib",
                "winmm.lib",
                "user32.lib",
                "shell32.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": ""
        }
    ],
    "version": "2.0.0"
}